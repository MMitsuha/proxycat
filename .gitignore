# Xcode
xcuserdata/
*.xcworkspace/xcuserdata
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen output (regenerable from project.yml)
ProxyCat.xcodeproj/

# gomobile output (regenerable via `python3 build.py libmihomo`)
Frameworks/

# Compile-time bundled assets (regenerable via `python3 build.py assets`). The
# directory layout is tracked via .gitkeep so xcodegen sees the folder
# reference; only the downloaded payload is excluded.
BundledAssets/geo/*
!BundledAssets/geo/.gitkeep
BundledAssets/ui/*
!BundledAssets/ui/.gitkeep

# Go module download cache
libmihomo/vendor/

# Go build artifacts
*.test
*.out
coverage.txt

# macOS
.DS_Store

# Python build tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/

# Log files
dbg*.txt
